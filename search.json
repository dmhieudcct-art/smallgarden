---
layout: none
---
[{% for post in site.posts %}{"id":{{ forloop.index0 }},"title":{{ post.title | jsonify }},"excerpt":{{ post.excerpt | strip_html | truncate: 300 | jsonify }},"content":{{ post.content | strip_html | truncate: 5000 | jsonify }},"categories":{{ post.categories | join: " " | jsonify }},"url":{{ post.url | relative_url | jsonify }},"lang":{{ post.lang | default: "en" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
